CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
# build-xnu-4k-baseline.sh refuses boot progress unless XNU_NATIVE_UFS,
# XNU_OWNER_ROOT_AUDIT, XNU_NATIVE_VIRTIO_BLOCK and XNU_SOURCE_CORECRYPTO14 are all 1
# (lines 79-82). Stage 1 turns the owner-root and Virtio switches off, so this has to
# go too; zzz-boot-progress.patch keeps every reference inside
# #if defined(XNU_BOOT_PROGRESS).
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_ARMVIRT_PLATFORM=n

# Stage-1 bring-up configuration for the storage qualification snapshot.
#
# Every symbol the full configuration pulls from the storage ABI audit is behind
# one of these switches: offline-legacy-start.patch guards native_legacy_display_*
# with XNU_NATIVE_LEGACY_DISPLAY, sheng-platform-power.patch guards sheng_pmgr_run
# with XNU_SHENG_PMGR, offline-owner-root-crypto-probe.patch guards
# native_verified_root_probe, offline-owner-systemos-mount.patch guards
# native_verified_block_volume_seed with XNU_NATIVE_RAM_BLOCK, and
# offline-owner-boot-manifest.patch guards the manifest digest with
# XNU_OWNER_BOOT_MANIFEST. None of them is referenced with these off, so this
# kernel links without build/storage-abi/interface-audit.json.
#
# What still links, and why it is safe here:
#   build-mockfs-fixture.py supplies the mockfs symbols that VFSTAB references
#   unconditionally; it needs no audit.
#   native_ram_block_gpu_addon is declared __attribute__((weak_import)), so its
#   absence is not a link error.
#
# Keep this file separate from sheng_defconfig: stage 1 exists only to produce a
# prelink candidate for the QEMU snapshot, never a bootable image.
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
# UniXNU-sm8550-common configs/sm8550.config selects this, and build-xnu-4k-baseline.sh
# then requires build/adreno740/libAdreno740.a (line 621). That driver does not compile
# under this configuration, so override the SoC fragment here: the defconfig is applied
# after the fragments.
CONFIG_XNU_NATIVE_ADRENO=n
